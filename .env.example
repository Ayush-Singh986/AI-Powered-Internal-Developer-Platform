# Copy to .env for local use. Keep the real .env out of Git.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Generate a distinct random token for each service and keep them in secret stores.
MODEL_SERVICE_API_KEY=
LLM_GATEWAY_API_KEY=replace-with-agent-gateway-token
PORTAL_GATEWAY_API_KEY=replace-with-portal-gateway-token
LLM_GATEWAY_CLIENT_KEYS={"agent":"replace-with-agent-gateway-token","portal":"replace-with-portal-gateway-token"}
AIOPS_ACTION_TOKEN=
AGENT_SERVICE_TOKEN=
RAG_SERVICE_TOKEN=
ALERTMANAGER_WEBHOOK_TOKEN=
DAILY_TOKEN_LIMIT=100000
CALLER_DAILY_TOKEN_LIMIT=100000
MAX_CALLS_PER_MINUTE=30
MAX_INPUT_BYTES=16000
MAX_REQUEST_BODY_BYTES=32768
MODEL_FALLBACK_URL=
MAX_LLM_CALLS_PER_HOUR=20
MAX_ACTIONS_PER_HOUR=3

# Optional. Set rates for the specific model/provider configured above.
# Leave blank to report tokens but not estimate monetary cost.
INPUT_COST_PER_1K_TOKENS_USD=
OUTPUT_COST_PER_1K_TOKENS_USD=

# Evidence collection is opt-in. Comma-separate only approved namespaces.
ALLOWED_NAMESPACES=rag
EVIDENCE_ENABLED_NAMESPACES=
MAX_REPLICAS=5
MAX_EVIDENCE_CHARS=10000
MAX_JOB_ATTEMPTS=5

# Local Grafana login only. Choose a non-default password before starting Compose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-this-local-password
